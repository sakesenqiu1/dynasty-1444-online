# 联机 / 部署需要的环境变量示例
#
# 用法（Windows PowerShell）：
#   $env:GS_HOST="1.2.3.4"; $env:GS_USER="root"; $env:GS_PASS="你的密码"; $env:GS_DOMAIN="game.example.com"
#
# 用法（Linux / macOS）：
#   export GS_HOST=1.2.3.4 GS_USER=root GS_PASS=你的密码 GS_DOMAIN=game.example.com
#
# 注意：真正跑游戏服务本身（srv/server.js）不需要这些；它们只用于部署与线上测试脚本。

# 服务器地址（IP 或域名）
GS_HOST=

# SSH 端口，默认 22
GS_PORT=22

# SSH 用户名，默认 root
GS_USER=root

# SSH 密码
GS_PASS=

# 对外访问的域名（用于 HTTPS / wss 测试；只有 IP 时可留空）
GS_DOMAIN=
